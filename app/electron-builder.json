{
	"appId": "com.deepnight.ldtk",
	"artifactName": "${productName} ${version} installer.${ext}",

	"directories": {
		"buildResources": "buildAssets",
		"output": "redist"
	},

	"extraFiles": [
		"extraFiles/embedAtlas",
		"extraFiles/changelogImg",
		{
			"from": "extraFiles/samples",
			"to": "extraFiles/samples",
			"filter": [
				"**/*",
				"!atlas/**/*.exe",
				"!atlas/**/*.dll",
				"!atlas/**/*.pdb",
				"!atlas/**/*.so",
				"!atlas/**/*.dylib",
				"!atlas/**/*.msi",
				"!atlas/**/*.bat",
				"!atlas/**/*.cmd",
				"!atlas/**/*.sh",
				"!atlas/**/*.import",
				"!atlas/**/*.md5",
				"!atlas/**/*.stex",
				"!atlas/**/*.DS_Store",
				"!atlas/**/*.ds_store",
				"!atlas/**/*.psd",
				"!atlas/**/*.pck",
				"!atlas/**/*.tscn",
				"!atlas/**/*.gd",
				"!atlas/**/*.cfg",
				"!atlas/**/*.meta",
				"!atlas/**/*.ctex",
				"!atlas/**/*.sample",
				"!atlas/**/*.cs"
			]
		},
		{
			"from": "extraFiles/README.txt",
			"to": "README.txt"
		}
	],

	"files": [
		"assets",
		"package.json"
	],

	"fileAssociations": [
		{
			"ext": "ldtk",
			"name": "LDTK Project File",
			"mimeType": "application/json",
			"icon": "project.ico",
			"role": "Editor"
		},
		{
			"ext": "ldtkl",
			"name": "LDTK Level File",
			"mimeType": "application/json",
			"icon": "level.ico",
			"role": "Editor"
		}
	],

	"nsis": {
		"oneClick": true,
		"shortcutName": "LDtk"
	},

	"win": {
		"target": "nsis",
		"publish": ["github"]
	},

	"mac": {}
}
